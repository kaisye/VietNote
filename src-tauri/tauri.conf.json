{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VietNote",
  "version": "0.8.7",
  "identifier": "local.vietnote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "VietNote", "width": 1280, "height": 820, "minWidth": 1000, "minHeight": 680, "backgroundColor": "#17142a" }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "15.0", "infoPlist": "Info.plist", "entitlements": "Entitlements.plist" },
    "resources": ["../asr"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFNDVBQzFGNjM5QzM1NjAKUldSZ05aeGpINnhGdnJMWlF1Mml1ZGlxaU5rL0dqZExOQjZ3SEZORDRFS3JPUjRDSlVxbGdxZmsK",
      "endpoints": ["https://github.com/kaisye/VietNote/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
