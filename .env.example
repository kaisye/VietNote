# Gemini 3.5 Transcribe + Live Translate is preferred when this key exists.
GEMINI_API_KEY=replace_with_google_ai_api_key
ASR_BACKEND=auto
GEMINI_ASR_MODEL=gemini-3.5-transcribe-live
GEMINI_LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview

# Local speaker diarization. Run bash scripts/setup-diarization.sh once.
DIARIZATION_BACKEND=nemotron
# Use DIARIZATION_BACKEND=off to disable; no diarization API key is needed.
# NEMOTRON_DEVICE=cpu
# NEMOTRON_LIBRARY=/absolute/path/libnemo_speech_asr_c.dylib
# NEMOTRON_MODEL=/absolute/path/Nemotron-3-Diarization.q8_0.gguf

# Optional Groq fallback.
# GROQ_API_KEY=gsk_replace_with_asr_key
GROQ_ASR_MODEL=whisper-large-v3

# Optional translation/summary provider.
# NINE_ROUTER_API_KEY=replace_with_key
